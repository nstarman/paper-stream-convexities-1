  journal       = {\mnras},
  keywords      = {galaxies: haloes, galaxies: formation, dark matter, methods: numerical, Astrophysics - Astrophysics of Galaxies},
  month         = sep,
  number        = {2},
  pages         = {2681-2697},
  primaryclass  = {astro-ph.GA},
  title         = {{The impact of galactic feedback on the shapes of dark-matter haloes}},
  volume        = {515},
  year          = 2022
}

