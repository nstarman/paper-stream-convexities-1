  journal       = {\mnras},
  month         = feb,
  number        = {4},
  pages         = {5225--5258},
  primaryclass  = {astro-ph.GA},
  title         = {{galstreams: A Library of Milky Way Stellar Stream Footprints and Tracks}},
  volume        = {520},
  year          = {2023}
}

