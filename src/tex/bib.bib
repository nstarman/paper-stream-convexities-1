  doi      = {10.1086/305273},
  file     = {/Users/nmrs/Zotero/storage/5WHTPAIZ/Johnston - 1998 - A Prescription for Building the Milky Way's Halo from Disrupted Satellites.pdf},
  issn     = {0004-637X},
  journal  = {\apj},
