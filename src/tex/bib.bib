@article{Li+:2024:GA2MIFGraphAttention,
  abstract     = {Multimodal Emotion Recognition in Conversation (ERC) plays an influential role in the field of human-computer interaction and conversational robotics since it can motivate machines to provide empathetic services. Multimodal data modeling is an up-and-coming research area in recent years, which is inspired by human capability to integrate multiple senses. Several graph-based approaches claim to capture interactive information between modalities, but the heterogeneity of multimodal data makes these methods prohibit optimal solutions. In this work, we introduce a multimodal fusion approach named Graph and Attention based Two-stage Multi-source Information Fusion (GA2MIF) for emotion detection in conversation. Our proposed method circumvents the problem of taking heterogeneous graph as input to the model while eliminating complex redundant connections in the construction of graph. GA2MIF focuses on contextual modeling and cross-modal modeling through leveraging Multi-head Directed Graph ATtention networks (MDGATs) and Multi-head Pairwise Cross-modal ATtention networks (MPCATs), respectively. Extensive experiments on two public datasets (i.e., IEMOCAP and MELD) demonstrate that the proposed GA2MIF has the capacity to validly capture intra-modal long-range contextual information and inter-modal complementary information, as well as outperforms the prevalent State-Of-The-Art (SOTA) models by a remarkable margin.},
  author       = {Li, Jiang and Wang, Xiaoping and Lv, Guoqing and Zeng, Zhigang},
  date         = {2024-01},
  doi          = {10.1109/TAFFC.2023.3261279},
  eprint       = {2207.11900},
  eprintclass  = {cs},
  eprinttype   = {arXiv},
  issn         = {1949-3045, 2371-9850},
  journaltitle = {IEEE Transactions on Affective Computing},
  keywords     = {Computer Science - Multimedia},
  number       = {1},
  pages        = {130--143},
  shortjournal = {IEEE Trans. Affective Comput.},
  shorttitle   = {{{GA2MIF}}},
  title        = {{{GA2MIF}}: {{Graph}} and {{Attention Based Two-Stage Multi-Source Information Fusion}} for {{Conversational Emotion Detection}}},
  url          = {http://arxiv.org/abs/2207.11900},
  urldate      = {2026-04-23},
  volume       = {15}
}

